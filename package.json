{
  "name": "zan-cms-backoffice",
  "version": "1.0.0",
  "description": "A Backoffice CMS for the Zan Municipality static website.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "npx tsc --project tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "npx nodemon --watch 'src/**/*.ts' --exec 'npx ts-node --project tsconfig.json src/index.ts'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "npx ts-node --project tsconfig.json prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnnyAbdelnour/git.git"
  },
  "keywords": [
    "cms",
    "express",
    "prisma",
    "typescript",
    "nodejs"
  ],
  "author": "Jules",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JohnnyAbdelnour/git/issues"
  },
  "homepage": "https://github.com/JohnnyAbdelnour/git#readme",
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "bcryptjs": "^2.4.3",
    "connect-sqlite3": "^0.9.13",
    "csurf": "^1.11.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.2",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-sqlite3": "^0.9.5",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/method-override": "^0.0.35",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.28",
    "@types/sharp": "^0.32.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}