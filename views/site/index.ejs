<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بلدية زان</title>
    <link rel="icon" href="/public/images/LogoZan.png" type="image/png">
    <link rel="stylesheet" href="/public/css/site.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="top-bar">
        <div class="container">
            <span><%= header.contact %></span>
            <span>|</span>
            <span><%= header.email %></span>
        </div>
    </div>
    <header>
        <div class="container">
            <div class="logo-container">
                <img src="/public/images/LogoZan.png" alt="شعار بلدية زان" id="logo">
                <h1>بلدية زان</h1>
            </div>
            <button class="menu-toggle" aria-label="Toggle menu">&#9776;</button>
            <nav>
                <ul>
                    <% menu.forEach(item => { %>
                        <li><a href="/<%= item.url.replace('.html', '') %>"><%= item.text %></a></li>
                    <% }); %>
                </ul>
            </nav>
        </div>
    </header>

    <section class="slider-container">
        <div class="slides">
            <% slider.forEach((slide, index) => { %>
                <div class="slide <%= index === 0 ? 'active' : '' %>">
                    <img src="<%= slide.image.startsWith('http') ? slide.image : '/public/' + slide.image %>" alt="Slider Image">
                    <div class="slide-caption">
                        <h2><%= slide.caption.title %></h2>
                        <p><%= slide.caption.text %></p>
                    </div>
                </div>
            <% }); %>
        </div>
        <button class="prev-slide">&#10094;</button>
        <button class="next-slide">&#10095;</button>
        <div class="slider-dots">
            <% slider.forEach((slide, index) => { %>
                <span class="dot <%= index === 0 ? 'active' : '' %>" data-slide="<%= index %>"></span>
            <% }); %>
        </div>
    </section>

    <main>
        <div class="container">
            <section class="welcome-section">
                <h2>أهلاً بكم في الموقع الرسمي لبلدية زان</h2>
                <p>نعمل لخدمتكم وتطوير مدينتنا. هنا يمكنكم العثور على معلومات حول خدماتنا ومشاريعنا وأخبارنا.</p>
            </section>

            <section class="quick-links">
                 <h3>روابط سريعة</h3>
                 <div class="links-container">
                    <a href="/services" class="link-box">الخدمات الإدارية</a>
                    <a href="/projects" class="link-box">المشاريع</a>
                    <a href="/contact" class="link-box">الشكاوى والاقتراحات</a>
                 </div>
            </section>

            <% Object.keys(cards).forEach(sectionKey => { %>
                <section class="card-section">
                    <a href="/<%= cards[sectionKey].link.replace('.html', '') %>" class="section-title-link"><h2 class="section-title"><%= cards[sectionKey].title %></h2></a>
                    <div class="cards-container">
                        <% cards[sectionKey].items.forEach(card => { %>
                            <div class="card" data-description="<%= card.description %>">
                                <% if (card.bannerImage) { %>
                                    <img src="<%= card.bannerImage.startsWith('http') ? card.bannerImage : '/public/' + card.bannerImage %>" alt="<%= card.title %> Banner" class="card-banner">
                                <% } %>
                                <img src="<%= card.image.startsWith('http') ? card.image : '/public/' + card.image %>" alt="صورة" class="card-image">
                                <div class="card-content">
                                    <h3><%= card.title %></h3>
                                    <a href="<%= card.buttonLink %>" class="card-button"><%= card.buttonText %></a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </section>
            <% }); %>
        </div>
    </main>
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h4><%= footer.about.title %></h4>
                    <p><%= footer.about.text %></p>
                </div>
                <div class="footer-section">
                    <h4><%= footer.links.title %></h4>
                    <ul>
                        <% footer.links.items.forEach(link => { %>
                            <li><a href="<%= link.url %>"><%= link.text %></a></li>
                        <% }); %>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4><%= footer.social.title %></h4>
                    <div class="social-media">
                        <% footer.social.items.forEach(social => { %>
                            <a href="<%= social.url %>" aria-label="<%= social.name %>"><i class="<%= social.icon %>"></i></a>
                        <% }); %>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p><%- footer.bottom.text %></p>
            </div>
        </div>
    </footer>
    <script src="/public/js/site.js"></script>
</body>
</html>