<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <h1><%= title %></h1>

    <h2>Add New Category</h2>
    <form action="/admin/events/category" method="POST">
        <input type="text" name="categoryName" placeholder="Category Name" required>
        <button type="submit">Add Category</button>
    </form>

    <% Object.keys(events).forEach(categoryKey => { %>
        <div class="category-section">
            <h2><%= events[categoryKey].name %>
                <form action="/admin/events/<%= categoryKey %>/delete_category" method="POST" style="display:inline;">
                    <button type="submit">Delete Category</button>
                </form>
            </h2>

            <h3>Add New Event to <%= events[categoryKey].name %></h3>
            <form action="/admin/events/<%= categoryKey %>" method="POST">
                <input type="text" name="title" placeholder="Event Title" required>
                <input type="date" name="date" required>
                <textarea name="description" placeholder="Event Description" required></textarea>
                <button type="submit">Add Event</button>
            </form>

            <h3>Existing Events in <%= events[categoryKey].name %></h3>
            <ul>
                <% events[categoryKey].items.forEach((item, index) => { %>
                    <li>
                        <form action="/admin/events/<%= categoryKey %>/update" method="POST" style="display:inline;">
                            <input type="hidden" name="index" value="<%= index %>">
                            <input type="text" name="title" value="<%= item.title %>" required>
                            <input type="date" name="date" value="<%= item.date %>" required>
                            <textarea name="description" required><%= item.description %></textarea>
                            <button type="submit">Update</button>
                        </form>
                        <form action="/admin/events/<%= categoryKey %>/delete" method="POST" style="display:inline;">
                            <input type="hidden" name="index" value="<%= index %>">
                            <button type="submit">Delete</button>
                        </form>
                    </li>
                <% }); %>
            </ul>
        </div>
    <% }); %>

    <a href="/admin">Back to Dashboard</a>
</body>
</html>