<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <form action="/admin/header" method="POST">
        <div>
            <label for="contact">Contact:</label>
            <input type="text" id="contact" name="contact" value="<%= header.contact %>" required>
        </div>
        <div>
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="<%= header.email %>" required>
        </div>
        <button type="submit">Update Header</button>
    </form>
    <a href="/admin">Back to Dashboard</a>
</body>
</html>