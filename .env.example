# Environment variables for Zan CMS Backoffice

# This file serves as an example. Copy it to .env and fill in the values.

# A secret key for signing the session ID cookie.
# It is recommended to use a long, random string.
SESSION_SECRET=a-very-strong-secret

# The following variables are already defined in the docker-compose.yml
# for the production environment, but are listed here for clarity and
# for use in a local Node.js setup.

# Database URL (using SQLite)
DATABASE_URL="file:./data/cms.sqlite"

# Directory for file uploads
UPLOAD_DIR="/app/uploads"

# Local path to the public repository for publishing
PUBLIC_REPO_LOCAL="/app/publish"

# Path within the public repository to publish data to
PUBLISH_DATA_PATH="/app/publish/data"

# Port for the application
PORT=8080