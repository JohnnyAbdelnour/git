<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <form action="/admin/footer/update" method="POST">

        <fieldset>
            <legend>About Section</legend>
            <textarea name="about_text" rows="3" required><%= footer.about.text %></textarea>
        </fieldset>

        <fieldset>
            <legend>Important Links</legend>
            <div id="links-container">
                <% footer.links.items.forEach(item => { %>
                    <div class="link-item">
                        <input type="text" name="link_text" placeholder="Link Text" value="<%= item.text %>" required>
                        <input type="text" name="link_url" placeholder="Link URL" value="<%= item.url %>" required>
                        <button type="button" onclick="removeField(this)">Remove</button>
                    </div>
                <% }); %>
            </div>
            <button type="button" id="add-link">Add Link</button>
        </fieldset>

        <fieldset>
            <legend>Social Media</legend>
            <div id="social-container">
                <% footer.social.items.forEach(item => { %>
                    <div class="social-item">
                        <input type="text" name="social_name" placeholder="Name (e.g., Facebook)" value="<%= item.name %>" required>
                        <input type="text" name="social_url" placeholder="URL" value="<%= item.url %>" required>
                        <input type="text" name="social_icon" placeholder="Icon (e.g., fab fa-facebook-f)" value="<%= item.icon %>" required>
                        <button type="button" onclick="removeField(this)">Remove</button>
                    </div>
                <% }); %>
            </div>
            <button type="button" id="add-social">Add Social Link</button>
        </fieldset>

        <fieldset>
            <legend>Footer Bottom</legend>
            <input type="text" name="bottom_text" value="<%= footer.bottom.text %>" required>
        </fieldset>

        <button type="submit">Update Footer</button>
    </form>
    <a href="/admin">Back to Dashboard</a>

    <script>
        document.getElementById('add-link').addEventListener('click', () => {
            const container = document.getElementById('links-container');
            const div = document.createElement('div');
            div.classList.add('link-item');
            div.innerHTML = `
                <input type="text" name="link_text" placeholder="Link Text" required>
                <input type="text" name="link_url" placeholder="Link URL" required>
                <button type="button" onclick="removeField(this)">Remove</button>
            `;
            container.appendChild(div);
        });

        document.getElementById('add-social').addEventListener('click', () => {
            const container = document.getElementById('social-container');
            const div = document.createElement('div');
            div.classList.add('social-item');
            div.innerHTML = `
                <input type="text" name="social_name" placeholder="Name (e.g., Facebook)" required>
                <input type="text" name="social_url" placeholder="URL" required>
                <input type="text" name="social_icon" placeholder="Icon (e.g., fab fa-facebook-f)" required>
                <button type="button" onclick="removeField(this)">Remove</button>
            `;
            container.appendChild(div);
        });

        function removeField(button) {
            button.parentElement.remove();
        }
    </script>
</body>
</html>