<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page.title %></title>
    <link rel="icon" href="/public/images/LogoZan.png" type="image/png">
    <link rel="stylesheet" href="/public/css/site.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="top-bar">
        <div class="container">
            <span><%= header.contact %></span>
            <span>|</span>
            <span><%= header.email %></span>
        </div>
    </div>
    <header>
        <div class="container">
            <div class="logo-container">
                <img src="/public/images/LogoZan.png" alt="شعار بلدية زان" id="logo">
                <h1>بلدية زان</h1>
            </div>
            <button class="menu-toggle" aria-label="Toggle menu">&#9776;</button>
            <nav>
                <ul>
                    <% menu.forEach(item => { %>
                        <li><a href="/<%= item.url.replace('.html', '') %>"><%= item.text %></a></li>
                    <% }); %>
                </ul>
            </nav>
        </div>
    </header>
    <main>
        <div class="container">
            <section class="page-header">
                <h1><%= page.header %></h1>
            </section>

            <section class="service-section">
                <h2 class="section-title"><%= page.workingHours.title %></h2>
                <div class="working-hours">
                    <p><%- page.workingHours.days %></p>
                    <p><%- page.workingHours.hours %></p>
                    <p><%- page.workingHours.note %></p>
                </div>
            </section>

            <section class="service-section">
                <h2 class="section-title"><%= page.forms.title %></h2>
                <div class="forms-container">
                    <input type="text" id="form-search" placeholder="ابحث عن نموذج...">
                    <ul id="forms-list">
                        <% page.forms.items.forEach(form => { %>
                            <li class="form-item">
                                <span class="form-name"><%= form.name %></span>
                                <a href="/public/<%= form.file %>" class="download-button" download>تحميل</a>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            </section>
        </div>
    </main>
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h4><%= footer.about.title %></h4>
                    <p><%= footer.about.text %></p>
                </div>
                <div class="footer-section">
                    <h4><%= footer.links.title %></h4>
                    <ul>
                        <% footer.links.items.forEach(link => { %>
                            <li><a href="<%= link.url %>"><%= link.text %></a></li>
                        <% }); %>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4><%= footer.social.title %></h4>
                    <div class="social-media">
                        <% footer.social.items.forEach(social => { %>
                            <a href="<%= social.url %>" aria-label="<%= social.name %>"><i class="<%= social.icon %>"></i></a>
                        <% }); %>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p><%- footer.bottom.text %></p>
            </div>
        </div>
    </footer>
    <script src="/public/js/site.js"></script>
</body>
</html>