<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page.title %></title>
    <link rel="icon" href="/public/images/LogoZan.png" type="image/png">
    <link rel="stylesheet" href="/public/css/site.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="top-bar">
        <div class="container">
            <span><%= header.contact %></span>
            <span>|</span>
            <span><%= header.email %></span>
        </div>
    </div>
    <header>
        <div class="container">
            <div class="logo-container">
                <img src="/public/images/LogoZan.png" alt="شعار بلدية زان" id="logo">
                <h1>بلدية زان</h1>
            </div>
            <button class="menu-toggle" aria-label="Toggle menu">&#9776;</button>
            <nav>
                <ul>
                    <% menu.forEach(item => { %>
                        <li><a href="<%= item.url %>"><%= item.text %></a></li>
                    <% }); %>
                </ul>
            </nav>
        </div>
    </header>
    <main>
        <div class="container">
            <section class="page-header">
                <h1><%= page.header %></h1>
            </section>
            <section class="contact-content">
                <div class="contact-form">
                    <h2><%= page.form.title %></h2>
                    <form action="/contact" method="POST">
                        <label for="name"><%= page.form.nameLabel %></label>
                        <input type="text" id="name" name="name" required>
                        <label for="email"><%= page.form.emailLabel %></label>
                        <input type="email" id="email" name="email" required>
                        <label for="message"><%= page.form.messageLabel %></label>
                        <textarea id="message" name="message" rows="5" required></textarea>
                        <button type="submit"><%= page.form.submitButton %></button>
                    </form>
                </div>
                <div class="contact-info">
                    <h2><%= page.info.title %></h2>
                    <p><%= page.info.address %></p>
                    <p><%= page.info.phone %></p>
                    <p><%= page.info.email %></p>
                </div>
            </section>
        </div>
    </main>
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h4><%= footer.about.title %></h4>
                    <p><%= footer.about.text %></p>
                </div>
                <div class="footer-section">
                    <h4><%= footer.links.title %></h4>
                    <ul>
                        <% footer.links.items.forEach(link => { %>
                            <li><a href="<%= link.url %>"><%= link.text %></a></li>
                        <% }); %>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4><%= footer.social.title %></h4>
                    <div class="social-media">
                        <% footer.social.items.forEach(social => { %>
                            <a href="<%= social.url %>" aria-label="<%= social.name %>"><i class="<%= social.icon %>"></i></a>
                        <% }); %>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p><%- footer.bottom.text %></p>
            </div>
        </div>
    </footer>
    <script src="/public/js/site.js"></script>
</body>
</html>