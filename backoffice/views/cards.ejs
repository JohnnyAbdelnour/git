<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <h1><%= title %></h1>

    <% Object.keys(cards).forEach(section => { %>
        <h2>Manage <%= section.charAt(0).toUpperCase() + section.slice(1) %> Cards</h2>

        <h3>Add New Card to <%= section %></h3>
        <form action="/admin/cards/<%= section %>" method="POST" enctype="multipart/form-data">
            <input type="file" name="image" required>
            <input type="text" name="title" placeholder="Card Title" required>
            <textarea name="description" placeholder="Card Description" required></textarea>
            <input type="text" name="buttonText" placeholder="Button Text" required>
            <input type="text" name="buttonLink" placeholder="Button Link" required>
            <button type="submit">Add Card</button>
        </form>

        <h3>Existing Cards in <%= section %></h3>
        <ul>
            <% cards[section].items.forEach((item, index) => { %>
                <li>
                    <img src="/public/<%= item.image %>" alt="<%= item.title %>" width="150">
                    <form action="/admin/cards/<%= section %>/update" method="POST" enctype="multipart/form-data" style="display:inline;">
                        <input type="hidden" name="index" value="<%= index %>">
                        <input type="file" name="image">
                        <input type="text" name="title" value="<%= item.title %>" required>
                        <textarea name="description" required><%= item.description %></textarea>
                        <input type="text" name="buttonText" value="<%= item.buttonText %>" required>
                        <input type="text" name="buttonLink" value="<%= item.buttonLink %>" required>
                        <button type="submit">Update</button>
                    </form>
                    <form action="/admin/cards/<%= section %>/delete" method="POST" style="display:inline;">
                        <input type="hidden" name="index" value="<%= index %>">
                        <button type="submit">Delete</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% }); %>

    <a href="/admin">Back to Dashboard</a>
</body>
</html>