<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <p>Select a page to edit:</p>
    <ul>
        <% pages.forEach(page => { %>
            <li><a href="/admin/pages/edit/<%= page %>"><%= page.charAt(0).toUpperCase() + page.slice(1) %></a></li>
        <% }); %>
    </ul>

    <h2>Create New Page</h2>
    <form action="/admin/pages/create" method="POST">
        <div>
            <label for="pageName">Page Name (e.g., 'about-us', 'contact'):</label>
            <input type="text" id="pageName" name="pageName" required pattern="[a-z0-9-]+">
        </div>
        <button type="submit">Create Page</button>
    </form>

    <a href="/admin">Back to Dashboard</a>
</body>
</html>